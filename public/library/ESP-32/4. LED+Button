<pre><code>/*
 * ============================================================
 * MY BRO'S FOURTH ESP32 PROGRAM: DIGITAL INPUT
 * ============================================================
 */

// Name our pins
const int LED_PIN = 2;
const int BUTTON_PIN = 14;

void setup()
{
    // LED sends power OUT
    pinMode(LED_PIN, OUTPUT);

    // Button READS power,
    // and we turn on the internal resistor!
    pinMode(BUTTON_PIN, INPUT_PULLUP);
}

void loop()
{
    // 1. READ THE BUTTON
    // We create a variable called 'buttonState'
    // to store what the ESP32 hears.
    // digitalRead() returns either HIGH or LOW.

    int buttonState = digitalRead(BUTTON_PIN);

    // 2. MAKE A DECISION
    // Because of INPUT_PULLUP,
    // pressing the button connects it to GND (LOW).

    if (buttonState == LOW)
    {
        // IF the button is PRESSED
        // Turn the LED ON

        digitalWrite(LED_PIN, HIGH);
    }
    else
    {
        // ELSE (if it is NOT pressed)
        // Turn the LED OFF

        digitalWrite(LED_PIN, LOW);
    }
}</code></pre>

