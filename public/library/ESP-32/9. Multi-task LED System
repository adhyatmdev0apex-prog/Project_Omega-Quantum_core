<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project 09 — Multi-Task LED System | Quantum Core</title>

<style>
:root{
    --bg:#050807;
    --bg2:#08100c;
    --panel:#0b120f;
    --panel2:#0f1814;
    --green:#39ff88;
    --green2:#16d96b;
    --cyan:#35d9ff;
    --yellow:#ffd84d;
    --red:#ff5c67;
    --text:#e7fff0;
    --muted:#82978b;
    --border:rgba(57,255,136,.14);
    --border2:rgba(255,255,255,.08);
    --shadow:0 20px 60px rgba(0,0,0,.45);
    --sidebar:285px;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    background:
        radial-gradient(circle at 15% 10%,rgba(57,255,136,.09),transparent 28%),
        radial-gradient(circle at 85% 80%,rgba(53,217,255,.055),transparent 25%),
        linear-gradient(135deg,var(--bg),var(--bg2));
    color:var(--text);
    font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    overflow-x:hidden;
}

body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:.15;
    background-image:
        linear-gradient(rgba(57,255,136,.035) 1px,transparent 1px),
        linear-gradient(90deg,rgba(57,255,136,.035) 1px,transparent 1px);
    background-size:44px 44px;
    mask-image:linear-gradient(to bottom,black,transparent 95%);
    z-index:-1;
}

button{
    font:inherit;
}

code,
pre{
    font-family:"JetBrains Mono","Cascadia Code","Fira Code",Consolas,monospace;
}

.sidebar{
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    width:var(--sidebar);
    padding:24px 18px;
    border-right:1px solid var(--border);
    background:rgba(5,8,7,.88);
    backdrop-filter:blur(20px);
    z-index:50;
    overflow-y:auto;
}

.brand{
    padding:4px 10px 22px;
    border-bottom:1px solid var(--border);
    margin-bottom:18px;
}

.brand-top{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--green);
    font-family:monospace;
    font-size:11px;
    font-weight:800;
    letter-spacing:.16em;
    text-transform:uppercase;
}

.brand-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 16px var(--green);
}

.brand h2{
    margin-top:9px;
    font-size:18px;
    letter-spacing:.04em;
}

.brand p{
    margin-top:5px;
    color:var(--muted);
    font-size:11px;
    line-height:1.5;
}

.progress-area{
    padding:0 10px 20px;
}

.progress-head{
    display:flex;
    justify-content:space-between;
    color:var(--muted);
    font-family:monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.08em;
    margin-bottom:8px;
}

.progress-track{
    height:4px;
    border-radius:20px;
    overflow:hidden;
    background:rgba(255,255,255,.06);
}

.progress-fill{
    width:7.14%;
    height:100%;
    background:linear-gradient(90deg,var(--green2),var(--green));
    box-shadow:0 0 14px rgba(57,255,136,.7);
    transition:width .35s ease;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:5px;
}

.nav-item{
    width:100%;
    display:flex;
    align-items:center;
    gap:11px;
    padding:10px 11px;
    border:1px solid transparent;
    border-radius:10px;
    background:transparent;
    color:#6f8177;
    cursor:pointer;
    text-align:left;
    transition:.2s ease;
}

.nav-item:hover{
    color:#b8d8c5;
    background:rgba(57,255,136,.035);
}

.nav-item.active{
    color:var(--green);
    background:rgba(57,255,136,.075);
    border-color:rgba(57,255,136,.13);
    box-shadow:inset 3px 0 var(--green);
}

.nav-number{
    min-width:24px;
    color:#53645b;
    font-family:monospace;
    font-size:10px;
}

.nav-item.active .nav-number{
    color:var(--green);
}

.nav-label{
    font-size:11px;
    font-weight:650;
}

.main{
    margin-left:var(--sidebar);
    min-height:100vh;
}

.topbar{
    position:sticky;
    top:0;
    height:58px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
    border-bottom:1px solid rgba(255,255,255,.045);
    background:rgba(5,8,7,.7);
    backdrop-filter:blur(18px);
    z-index:30;
}

.topbar-left{
    display:flex;
    align-items:center;
    gap:9px;
    color:var(--muted);
    font-family:monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.12em;
}

.status-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 12px var(--green);
}

.topbar-right{
    color:#607167;
    font-family:monospace;
    font-size:10px;
}

.content{
    width:min(1100px,calc(100% - 48px));
    margin:0 auto;
    padding:42px 0 110px;
}

.section{
    display:none;
    animation:sectionIn .35s ease;
}

.section.active{
    display:block;
}

@keyframes sectionIn{
    from{
        opacity:0;
        transform:translateY(10px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.hero{
    position:relative;
    overflow:hidden;
    padding:52px 48px;
    border:1px solid var(--border);
    border-radius:24px;
    background:
        radial-gradient(circle at 85% 20%,rgba(57,255,136,.12),transparent 28%),
        linear-gradient(145deg,rgba(14,26,20,.95),rgba(7,13,10,.96));
    box-shadow:var(--shadow);
}

.hero::after{
    content:"09";
    position:absolute;
    right:34px;
    bottom:-34px;
    color:rgba(57,255,136,.025);
    font-family:monospace;
    font-size:180px;
    font-weight:900;
    pointer-events:none;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:var(--green);
    font-family:monospace;
    font-size:10px;
    font-weight:800;
    letter-spacing:.17em;
    text-transform:uppercase;
}

.eyebrow::before{
    content:"";
    width:24px;
    height:1px;
    background:var(--green);
    box-shadow:0 0 8px var(--green);
}

h1{
    position:relative;
    z-index:1;
    margin-top:17px;
    max-width:850px;
    font-size:clamp(38px,6vw,72px);
    line-height:.95;
    letter-spacing:-.055em;
}

.gradient{
    color:var(--green);
    text-shadow:0 0 25px rgba(57,255,136,.18);
}

.hero-subtitle{
    position:relative;
    z-index:1;
    max-width:700px;
    margin-top:18px;
    color:#9eb3a6;
    font-size:15px;
    line-height:1.75;
}

.terminal{
    position:relative;
    z-index:1;
    margin-top:32px;
    padding:16px 18px;
    border:1px solid rgba(57,255,136,.12);
    border-radius:12px;
    background:#030605;
    color:#91a99b;
    font-family:monospace;
    font-size:11px;
}

.terminal span{
    color:var(--green);
}

.section-title{
    margin-bottom:24px;
}

.section-title .number{
    color:var(--green);
    font-family:monospace;
    font-size:11px;
    letter-spacing:.12em;
}

.section-title h2{
    margin-top:7px;
    font-size:34px;
    letter-spacing:-.035em;
}

.section-title p{
    margin-top:8px;
    color:var(--muted);
    line-height:1.7;
}

.card{
    margin-top:18px;
    padding:25px;
    border:1px solid var(--border);
    border-radius:18px;
    background:linear-gradient(145deg,rgba(13,22,17,.9),rgba(7,13,10,.9));
    box-shadow:0 12px 40px rgba(0,0,0,.2);
}

.card h3{
    font-size:17px;
    margin-bottom:11px;
}

.card p{
    color:#a0b3a8;
    line-height:1.75;
    font-size:14px;
}

.list{
    display:grid;
    gap:10px;
    margin-top:15px;
}

.list-item{
    display:flex;
    gap:12px;
    padding:13px 15px;
    border:1px solid rgba(255,255,255,.055);
    border-radius:11px;
    background:rgba(255,255,255,.018);
    color:#a9bdb0;
    line-height:1.55;
    font-size:13px;
}

.list-item::before{
    content:"›";
    color:var(--green);
    font-family:monospace;
    font-weight:bold;
}

.grid-2{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:16px;
}

.grid-3{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:15px;
}

.mini-card{
    padding:19px;
    border:1px solid var(--border2);
    border-radius:15px;
    background:rgba(255,255,255,.018);
}

.mini-card .icon{
    font-size:23px;
}

.mini-card h4{
    margin-top:9px;
    font-size:14px;
}

.mini-card p{
    margin-top:6px;
    font-size:12px;
    color:var(--muted);
    line-height:1.6;
}

.step-list{
    display:grid;
    gap:12px;
    margin-top:15px;
    counter-reset:steps;
}

.step{
    counter-increment:steps;
    position:relative;
    padding:17px 18px 17px 54px;
    border:1px solid rgba(255,255,255,.055);
    border-radius:13px;
    background:rgba(255,255,255,.018);
    color:#a9bdb0;
    line-height:1.65;
    font-size:13px;
}

.step::before{
    content:counter(steps,decimal-leading-zero);
    position:absolute;
    left:17px;
    top:17px;
    color:var(--green);
    font-family:monospace;
    font-size:10px;
}

.flow{
    display:flex;
    align-items:center;
    justify-content:center;
    flex-wrap:wrap;
    gap:9px;
    margin-top:20px;
}

.flow-box{
    padding:13px 17px;
    border:1px solid rgba(57,255,136,.16);
    border-radius:10px;
    background:rgba(57,255,136,.035);
    color:#bdeacc;
    font-family:monospace;
    font-size:11px;
    text-align:center;
}

.flow-arrow{
    color:var(--green);
    font-family:monospace;
}

.code-wrap{
    margin-top:18px;
    overflow:hidden;
    border:1px solid rgba(57,255,136,.13);
    border-radius:15px;
    background:#020504;
}

.code-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:10px 14px;
    border-bottom:1px solid rgba(255,255,255,.05);
    background:rgba(255,255,255,.025);
}

.code-lang{
    color:var(--green);
    font-family:monospace;
    font-size:10px;
    font-weight:800;
    letter-spacing:.12em;
}

.copy-btn{
    padding:6px 10px;
    border:1px solid rgba(255,255,255,.09);
    border-radius:7px;
    background:transparent;
    color:#74867c;
    cursor:pointer;
    font-family:monospace;
    font-size:10px;
    transition:.2s ease;
}

.copy-btn:hover{
    border-color:rgba(57,255,136,.3);
    color:var(--green);
}

pre.code{
    max-height:650px;
    overflow:auto;
    padding:20px;
    color:#b8d5c4;
    font-size:12px;
    line-height:1.7;
    white-space:pre;
}

pre.code::-webkit-scrollbar{
    width:8px;
    height:8px;
}

pre.code::-webkit-scrollbar-thumb{
    background:rgba(57,255,136,.12);
    border-radius:20px;
}

.wiring{
    margin-top:20px;
    padding:23px;
    border:1px solid rgba(53,217,255,.12);
    border-radius:15px;
    background:#030708;
    overflow:auto;
}

.wiring pre{
    color:#9dd6de;
    font-size:12px;
    line-height:1.8;
}

.note{
    margin-top:17px;
    padding:15px 17px;
    border-left:3px solid var(--yellow);
    border-radius:0 10px 10px 0;
    background:rgba(255,216,77,.045);
    color:#c8c19d;
    font-size:12px;
    line-height:1.65;
}

.note strong{
    color:var(--yellow);
}

.green-note{
    margin-top:17px;
    padding:15px 17px;
    border-left:3px solid var(--green);
    border-radius:0 10px 10px 0;
    background:rgba(57,255,136,.04);
    color:#a9c9b5;
    font-size:12px;
    line-height:1.65;
}

.timer-visual{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    gap:18px;
    margin-top:20px;
}

.timer-box{
    padding:23px;
    border:1px solid rgba(57,255,136,.13);
    border-radius:15px;
    background:rgba(57,255,136,.025);
    text-align:center;
}

.timer-box .big{
    color:var(--green);
    font-family:monospace;
    font-size:28px;
    font-weight:800;
}

.timer-box span{
    display:block;
    margin-top:7px;
    color:var(--muted);
    font-size:11px;
}

.timer-arrow{
    color:var(--green);
    font-family:monospace;
    font-size:22px;
}

.task-card{
    position:relative;
    overflow:hidden;
    min-height:190px;
}

.task-card::after{
    content:"TASK";
    position:absolute;
    right:12px;
    bottom:-10px;
    color:rgba(57,255,136,.025);
    font-family:monospace;
    font-size:70px;
    font-weight:900;
}

.task-number{
    color:var(--green);
    font-family:monospace;
    font-size:10px;
    letter-spacing:.12em;
}

.task-card h3{
    margin-top:9px;
}

.task-card p{
    margin-top:7px;
}

.expected{
    display:grid;
    gap:11px;
    margin-top:18px;
}

.expected-row{
    display:grid;
    grid-template-columns:115px 1fr;
    gap:15px;
    padding:14px;
    border:1px solid rgba(255,255,255,.05);
    border-radius:11px;
    background:rgba(255,255,255,.015);
}

.expected-label{
    color:var(--green);
    font-family:monospace;
    font-size:11px;
}

.expected-value{
    color:#a7bbb0;
    font-size:13px;
    line-height:1.55;
}

.challenge{
    border-color:rgba(255,216,77,.15);
    background:
        radial-gradient(circle at 90% 10%,rgba(255,216,77,.055),transparent 30%),
        linear-gradient(145deg,rgba(23,21,10,.75),rgba(9,13,10,.9));
}

.challenge h3{
    color:var(--yellow);
}

.trouble{
    display:grid;
    gap:12px;
    margin-top:18px;
}

.trouble-item{
    padding:17px;
    border:1px solid rgba(255,92,103,.11);
    border-radius:13px;
    background:rgba(255,92,103,.025);
}

.trouble-item strong{
    display:block;
    color:#ff8790;
    font-size:13px;
    margin-bottom:5px;
}

.trouble-item p{
    font-size:12px;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:18px;
    overflow:hidden;
    border:1px solid var(--border);
    border-radius:12px;
}

th,
td{
    padding:13px 15px;
    border-bottom:1px solid rgba(255,255,255,.055);
    text-align:left;
    font-size:12px;
}

th{
    color:var(--green);
    background:rgba(57,255,136,.045);
    font-family:monospace;
    text-transform:uppercase;
    letter-spacing:.08em;
}

td{
    color:#a4b7ab;
}

tr:last-child td{
    border-bottom:0;
}

.bottom-nav{
    display:flex;
    justify-content:space-between;
    gap:12px;
    margin-top:42px;
    padding-top:24px;
    border-top:1px solid rgba(255,255,255,.06);
}

.nav-btn{
    display:flex;
    align-items:center;
    gap:10px;
    padding:12px 16px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:10px;
    background:rgba(255,255,255,.025);
    color:#8ca095;
    cursor:pointer;
    transition:.2s ease;
}

.nav-btn:hover:not(:disabled){
    color:var(--green);
    border-color:rgba(57,255,136,.25);
    background:rgba(57,255,136,.035);
}

.nav-btn:disabled{
    opacity:.28;
    cursor:not-allowed;
}

.nav-btn small{
    display:block;
    color:#56675e;
    font-family:monospace;
    font-size:9px;
}

.mobile-header{
    display:none;
}

.mobile-progress{
    color:var(--green);
    font-family:monospace;
    font-size:10px;
}

kbd{
    padding:2px 5px;
    border:1px solid rgba(255,255,255,.1);
    border-radius:4px;
    background:rgba(255,255,255,.04);
    color:#9aac9f;
    font-family:monospace;
    font-size:10px;
}

@media(max-width:900px){
    .sidebar{
        display:none;
    }

    .main{
        margin-left:0;
    }

    .topbar{
        display:none;
    }

    .mobile-header{
        position:sticky;
        top:0;
        display:flex;
        align-items:center;
        justify-content:space-between;
        height:56px;
        padding:0 16px;
        border-bottom:1px solid var(--border);
        background:rgba(5,8,7,.9);
        backdrop-filter:blur(18px);
        z-index:40;
    }

    .mobile-brand{
        color:var(--green);
        font-family:monospace;
        font-size:10px;
        font-weight:800;
        letter-spacing:.12em;
    }

    .content{
        width:min(100% - 26px,1100px);
        padding:25px 0 70px;
    }

    .hero{
        padding:35px 25px;
        border-radius:19px;
    }

    .hero::after{
        font-size:100px;
    }

    h1{
        font-size:42px;
    }

    .grid-2,
    .grid-3{
        grid-template-columns:1fr;
    }

    .timer-visual{
        grid-template-columns:1fr;
    }

    .timer-arrow{
        transform:rotate(90deg);
        text-align:center;
    }

    .expected-row{
        grid-template-columns:1fr;
        gap:6px;
    }

    .bottom-nav{
        position:relative;
    }

    pre.code{
        font-size:11px;
    }
}
</style>

</head>

