<pre class="code">/*
 * ============================================================
 * MY BRO'S NINTH ESP32 PROGRAM: MULTI-TASKING SYSTEM
 * ============================================================
 */

// Name our pins
const int PIN_LED_BLINK = 2;
const int PIN_LED_TOGGLE = 4;
const int PIN_BTN_SPEED = 14;
const int PIN_BTN_TOGGLE = 15;

// Variables for Task 1 & 2 (Button Memory)
int lastBtnSpeedState = HIGH;
int lastBtnToggleState = HIGH;
int toggleLedState = LOW; // Remembers if LED 2 is ON or OFF

// Variables for Task 3 (Millis Blinker)
unsigned long previousMillis = 0;
unsigned long blinkInterval = 1000; // Starts at 1 second (1000ms)
int blinkLedState = LOW;

void setup() {
    pinMode(PIN_LED_BLINK, OUTPUT);
    pinMode(PIN_LED_TOGGLE, OUTPUT);
    pinMode(PIN_BTN_SPEED, INPUT_PULLUP);
    pinMode(PIN_BTN_TOGGLE, INPUT_PULLUP);
}

void loop() {
    // Read both buttons at the start of the loop
    int currentBtnSpeedState = digitalRead(PIN_BTN_SPEED);
    int currentBtnToggleState = digitalRead(PIN_BTN_TOGGLE);

    // ========================================================
    // TASK 1: TOGGLE LED 2
    // ========================================================
    if (lastBtnToggleState == HIGH && currentBtnToggleState == LOW) {
        if (toggleLedState == LOW) {
            toggleLedState = HIGH;
        } else {
            toggleLedState = LOW;
        }

        digitalWrite(PIN_LED_TOGGLE, toggleLedState);

        delay(50); // Tiny debounce
    }

    lastBtnToggleState = currentBtnToggleState;


    // ========================================================
    // TASK 2: CHANGE BLINK SPEED
    // ========================================================
    if (lastBtnSpeedState == HIGH && currentBtnSpeedState == LOW) {

        // If it's slow, make it fast.
        // If it's fast, make it slow!
        if (blinkInterval == 1000) {
            blinkInterval = 150;
        } else {
            blinkInterval = 1000;
        }

        delay(50); // Tiny debounce
    }

    lastBtnSpeedState = currentBtnSpeedState;


    // ========================================================
    // TASK 3: AUTO-BLINKER USING MILLIS
    // ========================================================
    unsigned long currentMillis = millis();

    // Notice that we use the 'blinkInterval' variable here!
    if (currentMillis - previousMillis &gt;= blinkInterval) {
        previousMillis = currentMillis;

        if (blinkLedState == LOW) {
            blinkLedState = HIGH;
        } else {
            blinkLedState = LOW;
        }

        digitalWrite(PIN_LED_BLINK, blinkLedState);
    }
}</pre>

